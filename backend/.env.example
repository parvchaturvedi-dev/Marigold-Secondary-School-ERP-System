PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-the-same-or-another-long-random-secret
FRONTEND_URL=https://your-vercel-app.vercel.app
CLIENT_ORIGIN=http://127.0.0.1:5173
# Optional additional origins, comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-vercel-app.vercel.app
EMAIL_USER=your-school-gmail@example.com
EMAIL_PASS=your-google-app-password
GMAIL_USER=your-gmail-address@example.com
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
EMAIL_FROM_NAME=MGPS ERP Portal
GMAIL_FROM_NAME=MGPS ERP Portal
# Gmail SMTP uses STARTTLS on port 587 by default to avoid IPv6 ENETUNREACH failures.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_FORCE_IPV4=true
GMAIL_CONNECTION_TIMEOUT_MS=20000
GMAIL_SOCKET_TIMEOUT_MS=30000
GMAIL_MAX_CONNECTIONS=3
# Legacy aliases are also accepted by the backend if already present:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
DEFAULT_AI_PROVIDER=gemini
# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
# Optional Hugging Face TTS for Hindi/Indic spoken replies
HUGGINGFACE_API_TOKEN=your-hugging-face-token
HF_TTS_MODEL=ai4bharat/indic-parler-tts
HF_TTS_DESCRIPTION=Divya's Hindi voice is clear, natural, close to the microphone, moderately paced, and easy to understand, with very clear audio and almost no background noise.
HF_TTS_TIMEOUT_MS=45000
# Optional setup helpers
AUTH_AUTO_PROVISION=false
# AUTH_AUTO_PROVISION_PASSWORD=replace-with-temporary-strong-password
