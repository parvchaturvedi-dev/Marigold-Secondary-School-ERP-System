PORT=5000
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Optional when your URI does not include a database name:
# MONGODB_DB_NAME=mgps_erp
# Optional frontend override. In Vite dev, /api is proxied automatically.
# VITE_API_BASE_URL=http://127.0.0.1:5000/api
# Use a long random value in production. Changing it signs out all users.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Set true only for first local setup, then create a real admin and turn it off.
AUTH_AUTO_PROVISION=false
# Required only while AUTH_AUTO_PROVISION=true.
# AUTH_AUTO_PROVISION_PASSWORD=replace-with-temporary-strong-password

# Gmail SMTP sender. Use a Google App Password, not your normal Gmail password.
GMAIL_USER=your-school-gmail@example.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_NAME=MGPS ERP Portal
