# Root .gitignore
logs
*.log
*.pid
scratch_*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
api-*.log
vite-*.log
*.out
*.err

node_modules
dist
dist-ssr
coverage
.vite
*.tsbuildinfo
release/
/release-print-1.0.3/
/release-print-1.0.3-final/
*.local
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.neon

# Local agent skills are not needed by EAS builds.
.agents/
.claude/

